#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x = 256) in;
layout(set=0, binding=0, std430) buffer O { double d[]; } o;
double exp_d(double x) {                       // series with the argument reduced to |r| <= ln2/2
    const double LN2_HI = 0.6931471803691238, LN2_LO = 1.9082149292705877e-10;
    const double k = roundEven(x / 0.6931471805599453);
    const double r = (x - k * LN2_HI) - k * LN2_LO;
    double t = 1.0, s = 1.0;
    for (int i = 1; i <= 18; ++i) { t *= r / double(i); s += t; }
    return ldexp(s, int(k));
}
void main() { const uint i = gl_GlobalInvocationID.x; if (i == 0u) o.d[0] = exp_d(o.d[1]); }
