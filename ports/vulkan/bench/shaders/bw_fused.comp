// ports/vulkan/bench/shaders/bw_fused.comp - the ON-CHIP arm: the SAME producer+consumer arithmetic as the
// two-dispatch chain (bw_stream -> bw_stream), but the INTERMEDIATE never leaves the workgroup - it is staged in
// SHARED memory and consumed after one barrier(), inside ONE dispatch.
//
// The chain it is priced against is `time_two(bw_stream{in->mid}, bw_stream{mid->out})`: kernel 1 writes the
// intermediate `mid` to GLOBAL memory and kernel 2 reads it back, i.e. two recorded links with a global round
// trip between them.  This kernel does the identical arithmetic (v * 1.0000001, twice) with the intermediate in
// `shared`, so the difference between the two rows is exactly the price of the global round trip and of the
// removed link, and the intra-workgroup barrier() cost falls out of this row itself.
//
// SHARED-MEMORY BUDGET: one workgroup stages 256 f32 = 1,024 B - the whole workgroup's slice - so it is 128x
// under the 131,072 B/workgroup the card reports.  A larger slice only changes the constant; the mechanism is
// the same and the budget line in the report states the general limit.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer I { float v[]; } in_;
layout(set = 0, binding = 1, std430) buffer O { float v[]; } out_;
layout(push_constant, std430) uniform PC { int n; } pc;
shared float staging[256];
void main() {
    const uint lid = gl_LocalInvocationIndex;
    const uint i = gl_GlobalInvocationID.x;
    // producer stage: transform into SHARED, not to global memory
    staging[lid] = (i < uint(pc.n)) ? in_.v[i] * 1.0000001 : 0.0;
    barrier();
    // consumer stage: read the intermediate back from SHARED and publish only the FINAL result to global
    const float mid = staging[lid];
    if (i < uint(pc.n)) out_.v[i] = mid * 1.0000001;
}
