// ports/vulkan/bench/shaders/bw_scatter.comp - the SCATTER arm of the scatter-vs-stream test.
//
// SAME BYTES AS bw_stream: N contiguous loads, N stores.  The ONLY difference is that the store address is
// perm[i] (a fixed bijection mod N) instead of i, so the write traffic is scattered over the whole output
// buffer instead of streaming.  The multiplier is odd, so i -> i*40503... is a bijection modulo the power-of-two
// N and the permutation neither aliases nor drops a byte.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer I { float v[]; } in_;
layout(set = 0, binding = 1, std430) readonly buffer P { uint v[]; } perm;
layout(set = 0, binding = 2, std430) buffer O { float v[]; } out_;
layout(push_constant, std430) uniform PC { int n; } pc;
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.n)) return;
    out_.v[perm.v[i]] = in_.v[i] * 1.0000001;
}
