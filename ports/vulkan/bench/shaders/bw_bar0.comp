// ports/vulkan/bench/shaders/bw_bar0.comp - the BARRIER-COUNT arm of the mechanism sweep.
//
// SAME BYTES, SAME GRID, SAME RECORDED PATH, SAME CHAIN BARRIER as every other bench arm; the ONLY thing that
// varies between bw_bar0/1/5/35 is the number of in-kernel barrier() calls: 0.  Each barrier() is a BARE
// OpControlBarrier (glslc emits one per call; run_bench.sh does not run spirv-opt), so the row prices the
// barrier SYNCHRONISATION itself and nothing else.  The shared staging write/read is present in ALL FOUR
// variants, so the shared-memory traffic is constant and the ONE co-variate is the barrier count.
//
// This exists to test the ONE surviving co-variate from the source analysis: cheap families have ZERO in-kernel
// barriers (ple_bcast 2.83 us/link) while every expensive family reduces through a wg_sum/rs_rank_max barrier
// tree (router_top10_f32 35 barriers, 288 us/link).  If the per-link price tracks 0, the mechanism is
// named; if the four prices are flat, the co-variate is coincidence and the suspect returns to device
// per-dispatch behaviour.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer I { float v[]; } in_;
layout(set = 0, binding = 1, std430) buffer O { float v[]; } out_;
layout(push_constant, std430) uniform PC { int n; } pc;
shared float staging[256];
void main() {
    const uint lid = gl_LocalInvocationIndex;
    const uint i = gl_GlobalInvocationID.x;
    staging[lid] = (i < uint(pc.n)) ? in_.v[i] * 1.0000001 : 0.0;
    const float mid = staging[lid];
    if (i < uint(pc.n)) out_.v[i] = mid * 1.0000001;
}
