// ports/vulkan/bench/shaders/bw_stream.comp - the STREAM arm of the scatter-vs-stream test.
//
// SAME BYTES AS bw_scatter: one contiguous load and one contiguous store per element, N floats in and N floats
// out.  The pair exists only to price the ACCESS PATTERN at a fixed byte volume: bw_stream writes out[i], and
// bw_scatter writes out[perm[i]] over the identical element count, so the two rows differ in the store ADDRESS
// pattern and in nothing else.  (This is NOT claimed to be the router's own shape - the router's source has no
// scattered store and no atomic; see the batch report.)
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer I { float v[]; } in_;
layout(set = 0, binding = 1, std430) buffer O { float v[]; } out_;
layout(push_constant, std430) uniform PC { int n; } pc;
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.n)) return;
    out_.v[i] = in_.v[i] * 1.0000001;
}
