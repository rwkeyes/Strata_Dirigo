// ports/vulkan/shaders/kv_q8_append.comp - 8-bit KV append, ported from src/kernels/cuda/kv_q8.cu.
//
// THE QUANTISATION, verbatim from kv_q8.hpp's own summary:
//     scale = fp16(max|x| / 127),  code = clamp(rint(x / scale), -127, 127)
// The detail a paraphrase gets wrong: the scale is rounded to fp16 FIRST and the codes are then computed against
// that STORED value (`sf = f32_from_f16(sbits)`), so the codes are consistent with the scale a reader will
// dequantise with.  Computing the codes against the unrounded `amax / 127` gives codes that are one step out at
// the boundary and would only show up as a small accuracy loss - so the gate checks the codes and the scale
// BITS exactly against a transcription of this formula.
//
// DECOMPOSITION: the CUDA source uses 64 threads per group with a warp-shuffle max and a shared-memory combine.
// This port uses ONE THREAD PER GROUP, looping the 64 values.  That is deliberately different and it is safe
// because a maximum is exact regardless of reduction order, so the value is identical - while the port gets to
// drop the shuffle, the barrier and every assumption about the subgroup width.  It is slower per group and it is
// the right trade for a correctness kernel; the reduction is the optimisation to make later.
//
// TWO DESTINATIONS, ONE KERNEL.  The source writes the VRAM page only when the block is resident
// (`table[pos / page_size] >= 0`) and ALWAYS writes the host copy in the identity layout.  Those are two
// different row formulas, so they are two dispatches of this kernel with `host_layout` selecting the formula -
// rather than two kernels that could drift apart.  A negative page means NO VRAM WRITE AT ALL, and the gate
// proves that with sentinels rather than by trusting the branch.
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256) in;

// The engine's fp16 conversion lives in one place now (shaders/common/f16_bits.glsl): three kernels convert and
// three copies of a bit-exact function is three chances to diverge.  See that file for why `packHalf2x16` is not
// used here - it saturates where the engine returns infinity, which silently changed one KV group's codes.
#include "common/f16_bits.glsl"
#define f16_from_f32(f) f16_from_f32_port(f)

layout(set = 0, binding = 0, std430) buffer KQ { int8_t q[]; } KQ_;
layout(set = 0, binding = 1, std430) buffer VQ { int8_t q[]; } VQ_;
layout(set = 0, binding = 2, std430) buffer KS { uint16_t s[]; } KS_;
layout(set = 0, binding = 3, std430) buffer VS { uint16_t s[]; } VS_;
layout(set = 0, binding = 4, std430) readonly buffer TAB { int t[]; } TAB_;
layout(set = 0, binding = 5, std430) readonly buffer STEP { int s[]; } STEP_;
layout(set = 0, binding = 6, std430) readonly buffer KC { float x[]; } KC_;
layout(set = 0, binding = 7, std430) readonly buffer VC { float x[]; } VC_;

layout(push_constant) uniform Pc {
    int kv_heads;
    int head_dim;
    int page_size;
    int host_layout;   // 0 = the page table decides the row (and a negative page skips the write)
                       // non-zero = the identity layout, always written (the KV-streaming host copy)
} pc;

const int GROUP = 64;

void main() {
    const int idx = int(gl_GlobalInvocationID.x);
    const int groups = pc.head_dim / GROUP;
    const int per_kv = pc.kv_heads * groups;
    if (idx >= 2 * per_kv) return;
    const bool is_v = idx >= per_kv;
    const int rem = is_v ? (idx - per_kv) : idx;
    const int h = rem / groups;
    const int g = rem - h * groups;

    const int pos = STEP_.s[0];                     // kStepPos == 0 in qsa.hpp's enum
    const int xbase = h * pc.head_dim + g * GROUP;

    float amax = 0.0;
    for (int t = 0; t < GROUP; ++t) {
        amax = max(amax, abs(is_v ? VC_.x[xbase + t] : KC_.x[xbase + t]));
    }
    // fp16 of the scale, as bits, then read BACK: the codes are quantised against the stored value.
    const uint sbits = uint(f16_from_f32(amax / 127.0f));
    // Reading the half back is a pure widening conversion (no rounding is possible), so the builtin is exact
    // here and the engine's own f32_from_f16 returns the same value for these bits.
    const float sf = unpackHalf2x16(sbits).x;

    int row = 0;
    if (pc.host_layout != 0) {
        row = ((pos / pc.page_size) * pc.kv_heads + h) * pc.page_size + (pos % pc.page_size);
    } else {
        const int page = TAB_.t[pos / pc.page_size];
        if (page < 0) return;                        // not resident: no VRAM write at all
        row = (page * pc.kv_heads + h) * pc.page_size + (pos % pc.page_size);
    }

    for (int t = 0; t < GROUP; ++t) {
        const float v = is_v ? VC_.x[xbase + t] : KC_.x[xbase + t];
        int q = 0;
        if (sf > 0.0) {                              // the source's guard: a zero scale means every code is 0
            const float qf = roundEven(v / sf);       // __float2int_rn: nearest, ties to even
            q = int(clamp(qf, -127.0, 127.0));
        }
        if (is_v) VQ_.q[row * pc.head_dim + g * GROUP + t] = int8_t(q);
        else KQ_.q[row * pc.head_dim + g * GROUP + t] = int8_t(q);
    }
    if (is_v) VS_.s[row * groups + g] = uint16_t(sbits);
    else KS_.s[row * groups + g] = uint16_t(sbits);
}
