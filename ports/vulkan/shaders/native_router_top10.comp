// ports/vulkan/shaders/native_router_top10.comp - the class-B FAST MoE router, ported from
// src/kernels/cuda/native_router.cu's `route` kernel (the canonical 512-expert / top-10 path,
// adapted from llama.cpp's topk-moe.cu).
//
// WHAT THE NATIVE BODY DOES DIFFERENTLY FROM `router_top10.cu` (the legacy router the port already has).
// Both implement the SAME rule - softmax over all 512 experts, a stable descending top-10 with ties by
// ascending index, then renormalise the ten by their own sum with ggml's 2**-14 lower clamp.  The difference
// is the ARITHMETIC, and it is the point of this symbol:
//
//   * the legacy kernel computes its exponentials AND its sum in DOUBLE (`exp((double)l - (double)mx)`, a
//     double sum, `inv = (float)(1.0/sum)`); router_top10_f32.comp reproduces that in float with KAHAN
//     compensation to keep the sum's error down;
//   * the native body computes `expf` and the sum in FLOAT, with a plain accumulate (`sum += values[i]`), and
//     normalises with `reciprocal = 1.0f / warp_sum(sum)`.
//
// So this shader transcribes the NATIVE arithmetic: a plain float exp/subtract, a plain float sum, and the
// renormalisation `selected * (1.0f / selected_sum)`.  The gate case therefore uses the engine's double
// transcription of the same RULE as the oracle (router_top10_parity.cpp's `reference`, which is what the
// native symbol's own parity test compares against) and MEASURES this f32 path's deviation from it - exactly
// as case_router measures the f32 variant's - rather than pretending the two arithmetics are identical.
//
// WARP -> BLOCK, AND WHY THE REDUCTIONS ARE PAIRWISE TREES.  The CUDA `route` kernel is 32 lanes x 8 rows with
// only row 0 active, and reduces with `__shfl_xor_sync`.  This port's discipline is that the target hardware is
// Intel (per-kernel SIMD width chosen by the driver), so reductions are BARRIER TREES and carry no subgroup op
// (run_gate.sh's census enforces it).  `wg_max`/`wg_sum` from common/wg_reduce.glsl are the port's proven trees
// and are reused here; the ARGMAX gets the same pairwise-tree shape below rather than a single-lane serial scan
// over shared memory, which llvmpipe was MEASURED to misbehave on for this kernel (the single-lane combine
// returned a max of 2.0 for lanes 8..255 where every input was 0.5 - a lane-group-dependent wrong answer that
// the Arc and RADV did not produce).  The max is exact and order-independent, so the tree IS the CUDA's answer;
// the sum is a different association, which is why the case tolerates and REPORTS the gap.
//
// THE SELECTION IS THE SOURCE'S ARGMAX, WITH THE SOURCE'S TIE-BREAK: a strict `>` scan in ascending expert
// order keeps the LOWEST index on an exact tie (`if (other > best || (other == best && other_id < expert))` in
// the CUDA).  The shared probability/taken arrays in common/router_select.glsl are reused; the reduction shape
// is local because it needs the (value, index) pair.
#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer LOGITS { float v[]; } logits;
layout(set = 0, binding = 1, std430) buffer IDS { int v[]; } ids;
layout(set = 0, binding = 2, std430) buffer WEIGHTS { float v[]; } weights;

#include "common/wg_reduce.glsl"
#include "common/router_select.glsl"

const uint NR_EXPERTS = 512u;
const uint NR_K = 10u;

shared float nr_ex[NR_EXPERTS];      // the float exponentials (the source's `values[]`)
shared float nr_selw[NR_K];          // the ten selected probabilities, in rank order
shared float nr_av[256];             // the argmax tree's per-invocation value ...
shared int nr_ai[256];               // ... and its expert index

layout(push_constant, std430) uniform PC { int n_tokens; } pc;

// The block-wide argmax, as a PAIRWISE TREE (the port's reduction shape) with the source's tie-break.
int nr_rank_max(uint lid, uint lsize) {
    float bv = rs_neg_inf();
    int bi = int(NR_EXPERTS);                 // loses to every real index
    for (uint e = lid; e < NR_EXPERTS; e += lsize) {
        if (rs_taken[e] != 0u) continue;
        const float pe = rs_p[e];
        if (pe > bv) { bv = pe; bi = int(e); }   // STRICT: the lowest index wins a tie
    }
    nr_av[lid] = bv;
    nr_ai[lid] = bi;
    barrier();
    for (uint step = lsize >> 1u; step > 0u; step >>= 1u) {
        if (lid < step) {
            const float ov = nr_av[lid + step];
            const int oi = nr_ai[lid + step];
            if (ov > nr_av[lid] || (ov == nr_av[lid] && oi < nr_ai[lid])) { nr_av[lid] = ov; nr_ai[lid] = oi; }
        }
        barrier();
    }
    return nr_ai[0];
}

void main() {
    const uint t = gl_WorkGroupID.x;
    if (t >= uint(pc.n_tokens)) return;
    const uint lid = gl_LocalInvocationIndex, lsize = gl_WorkGroupSize.x;
    const uint lbase = t * NR_EXPERTS;

    // ---- the stability maximum (the port's barrier tree; exact, so identical to the CUDA warp_max).
    float mx = rs_neg_inf();
    for (uint e = lid; e < NR_EXPERTS; e += lsize) mx = max(mx, logits.v[lbase + e]);
    mx = wg_max(mx);

    // ---- the exponentials, ONCE each, in FLOAT (the native arithmetic: `expf(values[i] - maximum)`), and a
    // plain-float partial sum per invocation.  This is NOT the Kahan sum of the portable legacy variant.
    float part = 0.0;
    for (uint e = lid; e < NR_EXPERTS; e += lsize) {
        const float ex = exp(logits.v[lbase + e] - mx);
        nr_ex[e] = ex;
        part += ex;
    }
    barrier();                                 // nr_ex visible before the probability pass reads it back
    const float inv = 1.0f / wg_sum(part);      // the source's `reciprocal = 1.0f / warp_sum(sum)`
    for (uint e = lid; e < NR_EXPERTS; e += lsize) {
        const float p = nr_ex[e] * inv;         // the source's `values[i] *= reciprocal`
        // `if (__isnanf(values[i])) values[i] = -FLT_MAX` - the bit pattern, since GLSL has no FLT_MAX.
        rs_p[e] = isnan(p) ? uintBitsToFloat(0xFF7FFFFFu) : p;
    }

    rs_clear_taken(NR_EXPERTS, lid, lsize);
    for (uint i = 0u; i < NR_K; ++i) {
        const int ix = nr_rank_max(lid, lsize);
        if (ix < int(NR_EXPERTS) && lid == 0u) {
            ids.v[t * NR_K + i] = ix;
            nr_selw[i] = rs_p[ix];
            rs_taken[ix] = 1u;
        }
        barrier();
    }
    if (lid == 0u) {
        float s = 0.0;
        for (uint i = 0u; i < NR_K; ++i) s += nr_selw[i];
        s = max(s, 6.103515625e-05f);        // 2**-14, ggml's clamp
        const float invs = 1.0f / s;         // the source's `inverse_selected_sum`
        for (uint i = 0u; i < NR_K; ++i) weights.v[t * NR_K + i] = nr_selw[i] * invs;
    }
}
