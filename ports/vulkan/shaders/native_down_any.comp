// ports/vulkan/shaders/native_down_any.comp - THE GENERIC GROUPED EXPERT DOWN PROJECTION, both pack formats.
//
// WHY ONE SHADER AND NOT TWO.  `coder-iq1_m`'s experts are down=IQ4_NL(20) on 39 layers and down=Q2_0(42) on 9.
// The two differ only in block geometry - IQ4_NL is 32 values / 18 B / 2 parts, Q2_0 is 64 values / 18 B / 2 parts
// (its `iqs` is the raw part index, no step) - and both read the SAME q8_1 hidden image `hq` (one row per ENTRY)
// and write `out[ent_dst[e]*n_embd + r]`.  So the grouping is written once and the format is `pc.ty`, exactly as
// the gate/up side.  The two `_dot` bodies are the already gated `iq4nl_dot` / `q2_0_dot` includes.
//
// THE ONE ADDRESSING DIFFERENCE from the gate/up side, and it is the source's: the activation row index is the
// ENTRY `e` (hq holds one row per entry, produced by the SwiGLU + q8_1 quantiser), while the OUTPUT row is
// `ent_dst[e]` - the entry's token.  Several entries can write the same token and their contributions are summed
// by the caller, so this kernel WRITES rather than adds.  Swapping those two indices is the signature defect here.
//
// THE WINDOWED WEIGHTS ADDRESS is identical to `native_gu_any.comp`'s (see the long note there): the weights view
// is bound at `pc.win_id * WIN_BYTES`, per-group offsets are within-window, and a group in another window is
// skipped.  Read that note before changing either file.
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer W { uint8_t b[]; } w_b;        // the expert weights (one window)
layout(set = 0, binding = 1, std430) readonly buffer A { uint8_t b[]; } act_b;      // hq: the hidden states (q8_1)
layout(set = 0, binding = 2, std430) readonly buffer GO { uint v[]; } grp_off;
layout(set = 0, binding = 3, std430) readonly buffer GW { uint v[]; } grp_win;
layout(set = 0, binding = 4, std430) readonly buffer GS { int v[]; } grp_start;
layout(set = 0, binding = 5, std430) readonly buffer NG { int v[]; } n_groups;
layout(set = 0, binding = 6, std430) readonly buffer ED { int v[]; } ent_dst;
layout(set = 0, binding = 7, std430) buffer OO { float v[]; } y;   // NOT `out`: that is a GLSL keyword

#include "common/wg_reduce.glsl"
#include "common/iq4nl_dot.glsl"
#include "common/q2_0_dot.glsl"

layout(push_constant, std430) uniform PC { int n_embd; int n_ff; int ty; int win_id; int d_row; int down_off; } pc;

const uint IQ4NL_QK = 32u, IQ4NL_IPB = 2u, IQ4NL_BLOCK = 18u;
const uint Q2_0_QK = 64u, Q2_0_IPB = 2u, Q2_0_BLOCK = 18u;

void main() {
    const uint n_embd = uint(pc.n_embd);
    const uint row = gl_WorkGroupID.x;
    if (row >= n_embd) return;                   // workgroup-uniform: the barriers stay legal
    const uint off = uint(pc.down_off) + row * uint(pc.d_row);
    const uint nparts = (pc.ty == 42) ? (uint(pc.n_ff) / 32u) : (uint(pc.n_ff) / 32u) * 2u;  // dot calls per row
    const uint hb = uint(pc.n_ff) / 32u;         // q8_1 blocks per entry of hq
    const uint lid = gl_LocalInvocationIndex;
    const uint ng = uint(n_groups.v[0]);

    for (uint g = gl_WorkGroupID.y; g < ng; g += gl_NumWorkGroups.y) {
        if (grp_win.v[g] != uint(pc.win_id)) continue;
        const uint wrow = grp_off.v[g] + off;
        const int e0 = grp_start.v[g], e1 = grp_start.v[g + 1];
        for (int e = e0; e < e1; ++e) {
            const uint arow = uint(e) * hb * 36u;
            float acc = 0.0;
            for (uint k = lid; k < nparts; k += gl_WorkGroupSize.x) {
                if (pc.ty == 42) {                                   // Q2_0: 64-value blocks, iqs = k%2
                    acc += q2_0_dot(wrow + (k / Q2_0_IPB) * Q2_0_BLOCK, arow + k * 36u, k % Q2_0_IPB);
                } else {                                             // IQ4_NL: 32-value blocks, iqs = 2*(k%2)
                    acc += iq4nl_dot(wrow + (k / IQ4NL_IPB) * IQ4NL_BLOCK, arow + (k / IQ4NL_IPB) * 36u, 2u * (k % IQ4NL_IPB));
                }
            }
            const float s = wg_sum(acc);
            if (lid == 0u) y.v[uint(ent_dst.v[e]) * n_embd + row] = s;
        }
    }
}
