// ports/vulkan/shaders/iq3xxs_mmvq.comp - ONE IQ3_XXS WEIGHT ROW against q8_1 activations, one workgroup per row.
//
// `mmvq_kernel<18>` with the format baked in, as `iq2s_mmvq.comp` is for type 22.  IQ3_XXS is the resident model's
// second most common expert gate/up format (17 of its 48 layers).  Same shape as its siblings: one workgroup (256)
// per row, a 32-value part per 32-lane group, the shared barrier tree for the reduction, and part k of the row IS
// its activation block.
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer W { uint8_t b[]; } w_b;
layout(set = 0, binding = 1, std430) readonly buffer A { uint8_t b[]; } act_b;
layout(set = 0, binding = 2, std430) readonly buffer G { uint v[]; } iq3xxs_grid_b;
layout(set = 0, binding = 3, std430) buffer Y { float v[]; } y;

#include "common/wg_reduce.glsl"
#include "common/iq3xxs_dot.glsl"

layout(push_constant, std430) uniform PC { int n_in; int n_out; int row_bytes; int ncols; } pc;

const uint IQ3XXS_BLOCK = 98u;                   // bytes per 256 values
const uint IQ3XXS_PARTS = 8u;                    // 32-value parts per block; the format's step is 2

void main() {
    const uint row = gl_WorkGroupID.x;
    if (row >= uint(pc.n_out)) return;           // workgroup-uniform: the reduction's barriers stay legal
    const uint nb = uint(pc.n_in) / 256u;        // IQ3_XXS blocks per row
    const uint arow_bytes = (uint(pc.n_in) / 32u) * 36u;
    const uint wrow = row * uint(pc.row_bytes);
    const uint lid = gl_LocalInvocationIndex;

    for (uint c = 0u; c < uint(pc.ncols); ++c) {
        const uint arow = c * arow_bytes;
        float acc = 0.0;
        for (uint k = lid; k < nb * IQ3XXS_PARTS; k += gl_WorkGroupSize.x) {
            acc += iq3xxs_dot(wrow + (k / IQ3XXS_PARTS) * IQ3XXS_BLOCK, arow + k * 36u, 2u * (k % IQ3XXS_PARTS));
        }
        const float total = wg_sum(acc);
        if (lid == 0u) y.v[c * uint(pc.n_out) + row] = total;
    }
}
