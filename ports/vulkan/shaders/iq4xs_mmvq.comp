// ports/vulkan/shaders/iq4xs_mmvq.comp - ONE IQ4_XS WEIGHT ROW against q8_1 activations, one workgroup per row.
//
// `mmvq_kernel<23>` with the format baked in.  IQ4_XS is the gate/up format of ONE layer of the resident model -
// but that layer is otherwise covered, so this format is what completes it.  Geometry: `Fmt<23>` is
// { qk 256, ipb 8, step 4 }, so part k of a row is weight block k/8 and activation block k, with `iqs` = 4*(k%8).
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer W { uint8_t b[]; } w_b;
layout(set = 0, binding = 1, std430) readonly buffer A { uint8_t b[]; } act_b;
layout(set = 0, binding = 2, std430) buffer Y { float v[]; } y;

#include "common/wg_reduce.glsl"
#include "common/iq4xs_dot.glsl"

layout(push_constant, std430) uniform PC { int n_in; int n_out; int row_bytes; int ncols; } pc;

const uint IQ4XS_BLOCK = 136u;                   // bytes per 256 values
const uint IQ4XS_PARTS = 8u;                     // the format's ipb; the step is 4

void main() {
    const uint row = gl_WorkGroupID.x;
    if (row >= uint(pc.n_out)) return;           // workgroup-uniform: the reduction's barriers stay legal
    const uint nb = uint(pc.n_in) / 256u;
    const uint arow_bytes = (uint(pc.n_in) / 32u) * 36u;
    const uint wrow = row * uint(pc.row_bytes);
    const uint lid = gl_LocalInvocationIndex;

    for (uint c = 0u; c < uint(pc.ncols); ++c) {
        const uint arow = c * arow_bytes;
        float acc = 0.0;
        for (uint k = lid; k < nb * IQ4XS_PARTS; k += gl_WorkGroupSize.x) {
            acc += iq4xs_dot(wrow + (k / IQ4XS_PARTS) * IQ4XS_BLOCK, arow + k * 36u, 4u * (k % IQ4XS_PARTS));
        }
        const float total = wg_sum(acc);
        if (lid == 0u) y.v[c * uint(pc.n_out) + row] = total;
    }
}
