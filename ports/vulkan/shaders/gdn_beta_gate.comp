#version 450
// ports/vulkan/shaders/gdn_beta_gate.comp - `beta = sigmoid(beta)`, in place, over the per-head scalars.
//
// Transcribed from `gdn_beta_gate_kernel` / `gdn_beta_gate` (src/kernels/cuda/gdn.cu:217-233); the contract is
// include/strata/kernels/gdn.hpp:82-88, and its call site is src/core/layer.cpp:299.
//
// WHY THIS KERNEL EXISTS AT ALL, in the engine's own words (gdn.cu:205-216): `gdn_step`'s contract is
// `d[h,j] = (v[h,j] - sk[h,j]) * beta[h]` and it applies NO sigmoid of its own, so what the recurrence receives
// has to be a FRACTION.  The layer glue owes this sigmoid; leaving it out (the "C1 bug") hands the recurrence
// the raw `ssm_beta @ cur`, which is unbounded and signed, and the delta-net write strength stops being a
// probability.  The gate's falsification drops the sigmoid and the arm must bite.
//
// THE BRANCH POLICY.  `gdn_layer` (src/core/layer.cpp:294-302) calls `native_gdn_beta_gate` when
// `native_gdn_enabled()`, else THIS legacy kernel - and the legacy branch is `{ gdn_beta_gate; gdn_gate; }`,
// whose second member `gdn_gate` this port already has.  The Vulkan backend answers `native_gdn_enabled() ==
// false` (see NEXT.md), so the layer takes this kernel and the native sibling is off the forward path.
//
// One thread per head, as the CUDA; the grid is sized to `n` (a grid sized to the work writes the same heads).
// No barrier, no subgroup op, no atomic.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) buffer B { float v[]; } b;
layout(push_constant, std430) uniform PC { int n; } pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.n)) return;
    b.v[i] = 1.0f / (1.0f + exp(-b.v[i]));
}
