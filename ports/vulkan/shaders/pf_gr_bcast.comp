#version 450
// ports/vulkan/shaders/pf_gr_bcast.comp - the PREFILL embedding broadcast into the hc residual stack.
//
// `gr_broadcast_kernel` (src/prefill/kernels.cu:199-204): R[t, c, d] = e[t, d] for all HC streams - the chunk's
// FIRST residual write, the prefill analogue of the decode's per-token broadcast.
layout(local_size_x = 256) in;
layout(push_constant, std430) uniform PC { int T; int N; int HC; } pc;
layout(set = 0, binding = 0, std430) readonly buffer EB { float v[]; } eb;   // e (T*N)
layout(set = 0, binding = 1, std430) buffer RB { float v[]; } rb;            // R (T*HC*N)

void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint HC = uint(pc.HC), N = uint(pc.N);
    if (i >= uint(pc.T) * HC * N) return;
    const uint t = i / (HC * N);
    const uint d = i % N;
    rb.v[i] = eb.v[t * N + d];
}
