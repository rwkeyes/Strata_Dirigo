#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
// to_f16_kernel: y[i] = f16_from_f32(x[i])
layout(local_size_x = 256) in;
layout(push_constant, std430) uniform PC { int n; } pc;
layout(set = 0, binding = 0, std430) buffer X { float x[]; } x_buf;
layout(set = 0, binding = 1, std430) buffer Y { uint16_t y[]; } y_buf;

uint16_t f16_from_f32(float f) {
    uint x = floatBitsToUint(f);
    uint sign = (x >> 16) & 0x8000u;
    uint rawexp = (x >> 23) & 0xFFu;
    int exp = int(rawexp) - 127 + 15;
    uint man = x & 0x7FFFFFu;
    if (rawexp == 0xFFu) return uint16_t(sign | 0x7C00u | (man != 0u ? 0x200u : 0u));
    if (exp >= 31) return uint16_t(sign | 0x7C00u);
    if (exp <= 0) {
        if (exp < -10) return uint16_t(sign);
        man |= 0x800000u;
        uint sh = uint(14 - exp);
        uint h = (man >> sh) & 0x3FFu;
        uint rem = man & ((1u << sh) - 1u);
        if (rem > (1u << (sh - 1)) || (rem == (1u << (sh - 1)) && (h & 1u) != 0u)) h = h + 1u;
        return uint16_t(sign | h);
    }
    uint16_t h = uint16_t(sign | (uint(exp) << 10) | (man >> 13));
    uint rem = man & 0x1FFFu;
    if (rem > 0x1000u || (rem == 0x1000u && (uint(h) & 1u) != 0u)) h = uint16_t(uint(h) + 1u);
    return h;
}

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i < pc.n) y_buf.y[i] = f16_from_f32(x_buf.x[i]);
}
