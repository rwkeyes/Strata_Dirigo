#version 450
// ports/vulkan/shaders/silu.comp - silu_inplace from src/kernels/cuda/elementwise.cu.
//
// THE DOUBLE IS THE KERNEL, not an accident: the CUDA source computes `(double)x / (1 + exp(-(double)x))` and
// casts, because `ref/gdn.py`'s numpy does, and the reference is the oracle.  Computing it in f32 changes the
// last bits on a large fraction of inputs, which the engine's own parity test measures.
//
// This file needs `shaderFloat64`.  Where the device does not report it (a Vulkan CPU implementation, or a
// vendor that gates fp64 off) the port falls back to shaders/silu_f32.comp and the gate applies the LOOSER
// tolerance that f32 arithmetic needs.  The fallback is chosen by the HOST from the device features, not by a
// build flag, so one tree of shaders runs everywhere.
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) buffer X { float v[]; } x;
layout(push_constant, std430) uniform PC { int n; } pc;

void main() {
    const int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.n) return;
    const double v = double(x.v[i]);
    x.v[i] = float(v / (1.0lf + exp(-v)));
}
