// ports/vulkan/shaders/coupled_sample.comp - the coupled drafter's SAMPLE, on the penalties coupled_penalize
// already applied.  Ported from `coupled_merge_kernel` (src/kernels/cuda/sampler.cu) plus the split selection it
// reuses (`sampler_split_part_kernel`, run there with empty SamplerParams because the penalties are already in the
// logits).  The host side is include/strata/core/coupled_draft.hpp.
//
// THE COUNTER IS THE WHOLE POINT, and it is the plain reading that is wrong.  A draft made at MTP cell `c` is
// verified by row `j` of the NEXT window, whose pick is drawn with counter `c + 1` - NOT `c`.  So the drafter draws
// its own sample with `coupled_draft_counter(cell) = cell + 1` and the SAME uniform the target will use for the
// row that verifies it; when the draft's distribution is close to the target's the two inverse-CDF picks from one
// uniform agree far more often than an argmax agrees with a sample, and the target's pick - and so the text - does
// not change.  A `+1`->`+0` here is a different (still valid) generator and a worse acceptance rate, which is
// exactly the class of change that reads as "the model got a bit worse": it is a gate arm and a falsification.
//
// The other coupled rules, all gate arms: the pick maps through `sub_to_id` to a token id (the draft head's
// vocabulary is a SUBSET), and the id is APPENDED to the ring at `cap + j` for the next draft's penalty window.
// A `temperature == 0` request cannot reach here (coupled_draft_sample is only called for sampled requests), but
// the engine keeps an argmax branch defensively - `greedy || temperature <= 0` -> `sel_ids[0]`, prob 1.

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer LOGITS { float x[]; } LO_;
layout(set = 0, binding = 1, std430) readonly buffer STEP_REC { int o[]; } STEP_;
layout(set = 0, binding = 2, std430) readonly buffer SUB_TO_ID { int v[]; } SUB_;
layout(set = 0, binding = 3, std430) buffer RING { int v[]; } RING_;
layout(set = 0, binding = 4, std430) buffer OUT_ID { int o[]; } OUT_;
layout(set = 0, binding = 5, std430) buffer OUT_PROB { float v[]; } PROB_;

layout(push_constant) uniform Pc {
    int n_vocab;            // the draft head's subset size
    int top_k;
    int min_keep;
    int greedy;             // the request's greedy flag (never set for a coupled call; the argmax branch is defensive)
    float temperature;      // 0 disables the draw (argmax), as in the engine
    float top_p;
    float min_p;
    uint seed_lo;
    uint seed_hi;
    int cap;
    int j;
} pc;

#define PORT_SAMPLER_WANT_F64
#include "common/sampler_tail.glsl"
#include "common/sampler_select.glsl"

void main() {
    if (gl_WorkGroupID.x != 0u) return;
    const int k = sc_k(pc.top_k, pc.n_vocab);
    sampler_row_topk(0, k);

    int pick = 0;
    float prob = 1.0;
    if (pc.greedy != 0 || pc.temperature <= 0.0) {
        pick = sc_sel_id[0];                        // the engine's defensive argmax: never the coupled path's
    } else {
        const uint counter_lo = uint(STEP_.o[0]) + 1u;   // coupled_draft_counter(cell) = cell + 1
        sampler_tail_f64(k, pc.temperature, pc.top_p, pc.min_p, pc.min_keep,
                         pc.seed_lo, pc.seed_hi, counter_lo, 0u, 0, pick, prob);
    }

    if (gl_LocalInvocationIndex == 0u) {
        const int id = SUB_.v[pick];                // the draft head's subset index -> a token id
        OUT_.o[0] = id;
        PROB_.v[0] = prob;
        RING_.v[pc.cap + pc.j] = id;                // draft j's token joins the ring for draft j+1's window
    }
}
