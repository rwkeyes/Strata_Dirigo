// ports/vulkan/shaders/swiglu_f32.comp - the same SwiGLU in float, for devices without shaderFloat64.
//
// WHAT THIS IS AND IS NOT. The engine has two SwiGLU kernels: the default one computes silu in DOUBLE (above),
// and the opt-in "native" one uses CUDA fast-math intrinsics - `__fdividef(gate, 1.0f + __expf(-gate)) * up`.
// This is NEITHER: it is the correctly-rounded float expression, because GLSL does not expose approximate
// divide/exp intrinsics and the port will not fake them. So the port's float path is MORE accurate than the
// engine's fast-math path and LESS accurate than its double path, and the gate measures it against the double
// reference rather than claiming either.
//
// The `(float)` cast position matters here too: the silu is rounded before the multiply by `up`.
#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer G { float v[]; } gate;
layout(set = 0, binding = 1, std430) readonly buffer U { float v[]; } up;
layout(set = 0, binding = 2, std430) buffer O { float v[]; } out_;

layout(push_constant, std430) uniform PC { int n; } pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.n)) return;
    const float x = gate.v[i];
    out_.v[i] = (x / (1.0 + exp(-x))) * up.v[i];
}
