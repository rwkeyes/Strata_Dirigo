// ports/vulkan/shaders/quantize_q8_0.comp - the activation -> ggml block_q8_0 conversion.
//
// Layout: 34 bytes per 32 elements, { fp16 d ; int8 qs[32] }.  "quantize_q8_0 ... still matches ggml's bytes,
// which is what moe_hit_parity checks" - so this kernel is a BYTE-EXACT reproduction of someone else's
// quantiser, and each of the three subtleties below was paid for once already in the source's history.
//
//   1. `d32 = amax / 127.0f` is computed in FP32 and the INTEGERS divide by `d32`, NOT by the fp16-rounded value
//      that gets stored.  Conflating the two shifts every quant near a rounding boundary: the source measured
//      18 of 80 blocks differing from ggml's own bytes, and the error landed in all 48 MoE blocks.
//   2. The division is FLOAT64 and the rounding is round-half-to-EVEN (`rint`).  An f32 division followed by
//      rintf differs wherever the f32 quotient rounds across a .5 boundary - which is why this shader needs the
//      device's shaderFloat64 and why the caller must check for it.
//   3. The stored scale is fp16 (`d16`), and a READER dequantises with `q * d16`, not `q * d32`.
//
// The zero block is written explicitly (d = 0, every q = 0) rather than skipped: ggml leaves it zeroed, and a
// byte comparison cannot tell a written zero block from an untouched one.
#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
// uint16_t is the shared converter's return type: the int16 arithmetic-types extension is what makes it a TYPE
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer X { float x[]; } X_;
layout(set = 0, binding = 1, std430) buffer BLK { uint8_t b[]; } B_;

#include "common/f16_bits.glsl"
#define f16_from_f32(f) f16_from_f32_port(f)

layout(push_constant) uniform Pc {
    int n_blocks;
} pc;

const int QK8_0 = 32;

void main() {
    const int blk = int(gl_GlobalInvocationID.x);
    if (blk >= pc.n_blocks) return;
    const int xb = blk * QK8_0;
    const int ob = blk * 34;

    float amax = 0.0;
    for (int i = 0; i < QK8_0; ++i) amax = max(amax, abs(X_.x[xb + i]));
    if (amax == 0.0) {
        const uint16_t zb = f16_from_f32(0.0);
        B_.b[ob] = uint8_t(zb & 0xFFu);
        B_.b[ob + 1] = uint8_t(zb >> 8);
        for (int i = 0; i < QK8_0; ++i) B_.b[ob + 2 + i] = uint8_t(0);
        return;
    }

    const float d32 = amax / 127.0;
    const uint16_t d16 = f16_from_f32(d32);
    B_.b[ob] = uint8_t(d16 & 0xFFu);
    B_.b[ob + 1] = uint8_t(d16 >> 8);

    for (int i = 0; i < QK8_0; ++i) {
        // float64, and round-half-to-EVEN - the reference's `rint`, not a nearest-away rule
        double q = roundEven(double(X_.x[xb + i]) / double(d32));
        q = clamp(q, -128.0, 127.0);
        // a signed byte written portably: a value conversion of -1 into uint8_t is not something to rely on
        const int v = int(q);
        B_.b[ob + 2 + i] = uint8_t(v < 0 ? v + 256 : v);
    }
}
