#version 450
// ports/vulkan/shaders/qsa_gate_apply_f32.comp - the LEGACY QSA attention-output gate, in f32.
//
// Transcribed from `qsa_gate_apply_f32_kernel` / `qsa_gate_apply_f32` (src/kernels/cuda/qsa.cu:793-810); the
// contract is include/strata/kernels/qsa.hpp:314-324 and the rule is re-pinned by src/kernels/qsa_parity.cpp's
// `ref_gate`.  Call site src/core/layer.cpp:1011.
//
// THE RULE, elementwise over the (n_head, head_dim) attention output:
//
//     g     = q_full[ h * 2*head_dim + head_dim + d ]     // the SECOND half of each head's 2*head_dim block
//     sig   = 1 / (1 + exp(-g))                           // SIGMOID, not SiLU
//     out   = attn * sig
//
//   * the split is NOT element-interleaved: `q = per_head[:, :head_dim]` and `gate = per_head[:, head_dim:]`, so
//     the gate is the SECOND half (`qsa_parity.cpp` PROPERTY 10 / its `gate_second_half` rival).  Reading the
//     FIRST half is the plausible wrong layout and produces a well-formed, different vector.
//   * SIGMOID, not SiLU.  This artifact's QSA gate is a sigmoid; the qwen3.5 reading is SiLU.
//
// THE BRANCH POLICY this kernel belongs to.  `qsa_layer` (src/core/layer.cpp:1009-1012) calls
// `native_qsa_gate_apply` when `native_qsa_enabled()`, else THIS legacy kernel - a native/legacy pair like the
// GDN ones, and the `native_qsa_gate_apply` sibling is equally unported.  The Vulkan backend answers
// `native_qsa_enabled() == false` (the QSA half of the same policy in NEXT.md; the flag also gates the class-B
// `native_qsa_rms_norm_weighted` dodge), so the layer runs THIS kernel.  No CPU fallback is involved.
//
// WHAT DIFFERS FROM THE CUDA.  The CUDA forms the product in DOUBLE (`(float)((double)attn * sig)` with a double
// `exp`).  The target device has no shaderFloat64, so this port multiplies and exponentiates in F32 and the gate
// MEASURES the gap against the engine's double oracle rather than claiming bit-exactness.  One thread per output
// element, as the CUDA; no barrier, no subgroup op, no atomic.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer A { float v[]; } attn;  // (n_head, head_dim)
layout(set = 0, binding = 1, std430) readonly buffer QF { float v[]; } qfull; // (n_head, 2*head_dim)
layout(set = 0, binding = 2, std430) buffer OUT { float v[]; } outb;          // (n_head, head_dim)
layout(push_constant, std430) uniform PC { int n_head; int head_dim; } pc;

void main() {
    const uint hd = uint(pc.head_dim);
    const uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.n_head) * hd) return;
    const uint h = i / hd;
    const uint d = i % hd;
    const float g = qfull.v[h * 2u * hd + hd + d];   // the SECOND half of the 2*head_dim block
    outb.v[i] = attn.v[i] * (1.0f / (1.0f + exp(-g)));
}
