#version 450
// ports/vulkan/shaders/rms_norm.comp - rms_norm_weighted from src/kernels/cuda/elementwise.cu.
//
// ONE WORKGROUP PER ROW.  This replaced a subgroup-per-row version, and the reason is a VENDOR-COMPATIBILITY
// bug rather than style: with one subgroup per row the HOST has to know how many subgroups a workgroup
// contains (rows-per-workgroup = local_size_x / subgroupSize) to size its dispatch, and the subgroup width is
// the DRIVER's choice.  `VkPhysicalDeviceSubgroupProperties.subgroupSize` is a device-wide default; where
// `VK_EXT_subgroup_size_control` is exposed the driver may compile a given kernel at a different width (Intel's
// compiler picks SIMD8/16/32 per kernel), and the host would then dispatch too FEW workgroups - silently
// skipping the tail rows with no error at all.  Workgroup-per-row removes the agreement entirely: row =
// gl_WorkGroupID.x, the dispatch is exactly `rows` workgroups, and the width appears only INSIDE the kernel
// (gl_NumSubgroups / gl_SubgroupSize, both compile-time constants of the pipeline that actually runs).
//
// It also makes the barriers below legal.  Every invocation of a workgroup shares the same `row`, so the
// early return is workgroup-uniform and no barrier is left half-executed; under subgroup-per-row that would
// not have held.
//
// WHAT ELSE DIFFERS FROM THE CUDA SOURCE, and why:
//  1. The CUDA kernel hardcodes 32 lanes (`threadIdx.x & 31`, `>> 5`, a shuffle-down tree from 16).  Nothing
//     here assumes a width - the reduction is `subgroupAdd` per subgroup, then `gl_NumSubgroups` entries
//     combined by the first subgroup.  Copying the 32-lane arithmetic would compute a wrong sum at width 64.
//  2. The CUDA reduction is a fixed shuffle-down tree; `subgroupAdd` leaves the order to the driver.  Both
//     are correct sums and differ in the last bits, so the gate compares against a double-precision reference
//     rather than bit-for-bit.
//  3. CUDA's `w` may be null (`w ? r[c]*w[c] : r[c]`).  Vulkan has no null descriptor here, so the port
//     REQUIRES a weight buffer and the caller passes ones when the norm is unweighted.  `r * 1.0f * inv` is
//     exactly `r * inv` in IEEE, so this changes the interface, not the arithmetic.
//
// THE ROW GUARD IS NOT DECORATION.  In the CUDA source its absence was the QSA bug (the launcher rounded the
// grid up and rows 2 and 3 of a 2-row call wrote past the end of their buffer).  Here the dispatch is exact,
// but the guard stays because it is what makes an over-dispatch harmless rather than destructive, and the
// gate keeps a NaN-filled tail in the allocation so an over-dispatch is detected instead of tolerated.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) buffer X { float v[]; } x;
layout(set = 0, binding = 1, std430) readonly buffer W { float v[]; } w;
layout(push_constant, std430) uniform PC { int rows; int cols; float eps; } pc;

#include "common/wg_reduce.glsl"

void main() {
    const uint row = gl_WorkGroupID.x;
    if (row >= uint(pc.rows)) return;

    const uint cols = uint(pc.cols);
    const uint base = row * cols;
    const uint lid = gl_LocalInvocationIndex;
    const uint lsize = gl_WorkGroupSize.x;

    float acc = 0.0;
    for (uint c = lid; c < cols; c += lsize) {
        const float t = x.v[base + c];
        acc += t * t;
    }

    // The workgroup-wide sum, from the shared reduction (see common/wg_reduce.glsl for the two defects it
    // encodes).  Every invocation gets the total back, so the mean and the broadcast are computed redundantly
    // here instead of being staged through another shared variable and barrier.
    const float inv = inversesqrt(wg_sum(acc) / float(pc.cols) + pc.eps);
    for (uint c = lid; c < cols; c += lsize) {
        const uint i = base + c;
        x.v[i] = (x.v[i] * w.v[i]) * inv;
    }
}
