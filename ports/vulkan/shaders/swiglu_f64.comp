// ports/vulkan/shaders/swiglu_f64.comp - the shared expert's SwiGLU, FAITHFUL arithmetic.
//
//     out[i] = (float)( x / (1 + exp(-x)) ) * up[i]        with x = (double) gate[i]
//
// **THE SILU IS COMPUTED IN DOUBLE, and the multiplication by `up` is the reference's order** (ref/moe.py works
// in float64). The `(float)` cast applies to the silu BEFORE the multiply - writing the cast later is a different
// value.
//
// THIS UNBLOCKS A SHADER THE PORT HAD TO SHELVE. An early attempt at a double-precision silu was parked in
// `shaders/blocked/silu_fp64.comp` because glslang has no `exp(double)` and the port noted it as inexpressible.
// It is expressible: common/double_math.glsl builds the double exp from roundEven + ldexp + a series, and the
// router needed exactly the same piece. What is still true is that this file requires the device's shaderFloat64,
// which Intel Arc does not have (see the f32 sibling).
#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer G { float v[]; } gate;
layout(set = 0, binding = 1, std430) readonly buffer U { float v[]; } up;
layout(set = 0, binding = 2, std430) buffer O { float v[]; } out_;

#include "common/double_math.glsl"

layout(push_constant, std430) uniform PC { int n; } pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.n)) return;
    const double x = double(gate.v[i]);
    const float silu = float(x / (1.0 + double_exp(-x)));
    out_.v[i] = silu * up.v[i];
}
