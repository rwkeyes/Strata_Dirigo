#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
// to_bf16_kernel: y[i] = bf16_from_f32(x[i])
layout(local_size_x = 256) in;
layout(push_constant, std430) uniform PC { int n; } pc;
layout(set = 0, binding = 0, std430) buffer X { float x[]; } x_buf;
layout(set = 0, binding = 1, std430) buffer Y { uint16_t y[]; } y_buf;

uint16_t bf16_from_f32(float f) {
    uint i = floatBitsToUint(f);
    if ((i & 0x7FFFFFFFu) > 0x7F800000u) return uint16_t((i >> 16) | 64u);
    i = (i + ((i >> 16) & 1u) + 0x7FFFu) & 0xFFFF0000u;
    return uint16_t(i >> 16);
}

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i < pc.n) y_buf.y[i] = bf16_from_f32(x_buf.x[i]);
}
